{
    "compilerOptions": {
        "baseUrl": ".",
        "declaration": true,
        "lib": ["ES2019"],
        "module": "commonjs",
        "noEmitOnError": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "./dist",
        "resolveJsonModule": true,
        "rootDir": "./src",
        "skipDefaultLibCheck": true,
        "skipLibCheck": true,
        "types": ["jasmine", "node"]
    },
    "exclude": ["./src/*/files/**/*"],
    "extends": "../../../tsconfig.main.json",
    "include": ["./src/**/*"]
}
